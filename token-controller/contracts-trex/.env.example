# Copie para .env.local e exporte antes de rodar os deploys.
# NUNCA commitar chaves reais.

# Chave privada do deployer/agente (precisa de gas na chain).
# Em produção, será owner do IdFactory + agente do IdentityRegistry + management key.
DEPLOYER_PK=0xYOUR_PRIVATE_KEY

# RPCs
RPC_AMOY=https://rpc-amoy.polygon.technology
RPC_POLYGON=https://polygon-rpc.com

# (opcional) verificação no explorer
POLYGONSCAN_KEY=
